{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ODATA Pokemon API",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/MiColeccionCartasPokemon/ODATAPokemonApi/bin/Debug/net10.0/ODATAPokemonApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/MiColeccionCartasPokemon/ODATAPokemonApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/odata/PokemonCards"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5123"
            }
        },
    ]
}