<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design System Colors -->
    <Color x:Key="Primary">#E3350D</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#FFDAD3</Color>
    <Color x:Key="OnPrimaryContainer">#400000</Color>
    <Color x:Key="Secondary">#3168B1</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#D6E3FF</Color>
    <Color x:Key="OnSecondaryContainer">#001B3D</Color>
    <Color x:Key="Tertiary">#FFCC00</Color>
    <Color x:Key="OnTertiary">#332900</Color>
    <Color x:Key="TertiaryContainer">#FFE873</Color>
    <Color x:Key="OnTertiaryContainer">#4D3E00</Color>
    
    <Color x:Key="Background">#F8F9FA</Color>
    <Color x:Key="BackgroundDark">#121212</Color>
    <Color x:Key="OnBackground">#1A1C1E</Color>
    <Color x:Key="OnBackgroundDark">#FFFFFF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>
    <Color x:Key="OnSurface">#1A1C1E</Color>
    <Color x:Key="OnSurfaceDark">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#E7E0EC</Color>
    <Color x:Key="SurfaceVariantDark">#49454F</Color>
    <Color x:Key="OnSurfaceVariant">#49454F</Color>
    <Color x:Key="OnSurfaceVariantDark">#CAC4D0</Color>
    <Color x:Key="Outline">#79747E</Color>
    <Color x:Key="OutlineDark">#938F99</Color>
    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorDark">#F2B8B5</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="OnErrorDark">#601410</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#1A1C1E</Color>
    <Color x:Key="PrimaryDark">#FFDAD3</Color>
    <Color x:Key="PrimaryDarkText">#400000</Color>
    <Color x:Key="SecondaryDarkText">#001B3D</Color>
    <Color x:Key="BackgroundLight">#F8F9FA</Color>
    <Color x:Key="OffBlack">#1A1C1E</Color>
    <Color x:Key="MidnightBlue">#001B3D</Color>
    <Color x:Key="Magenta">#E3350D</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>