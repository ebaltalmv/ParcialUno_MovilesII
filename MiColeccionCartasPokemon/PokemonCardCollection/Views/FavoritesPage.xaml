<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokemonCardCollection.ViewModels"
             xmlns:models="clr-namespace:PokemonCardCollection.Models"
             x:Class="PokemonCardCollection.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="Favorites"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="*" Padding="16">

        <CollectionView ItemsSource="{Binding FavoriteCards}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding GoToDetailCommand}"
                        SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No favorites yet!" FontSize="20" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                    <Label Text="Mark cards as ★ to see them here." FontSize="14" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PokemonCard">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Black}}" Padding="12">
                        <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUri}"
                                   Aspect="AspectFill"
                                   HeightRequest="80"
                                   WidthRequest="80" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Secondary}" Padding="8,4" StrokeThickness="0">
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="{StaticResource White}" FontAttributes="Bold" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Tertiary}" Padding="8,4" StrokeThickness="0">
                                        <Label Text="{Binding Rarity}" FontSize="12" TextColor="{StaticResource Black}" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="★ Favorite" FontSize="13" TextColor="{StaticResource Tertiary}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
