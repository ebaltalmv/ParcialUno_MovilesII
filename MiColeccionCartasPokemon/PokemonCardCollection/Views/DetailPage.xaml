<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokemonCardCollection.ViewModels"
             x:Class="PokemonCardCollection.Views.DetailPage"
             x:DataType="vm:DetailViewModel"
             Title="Card Details"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Card image -->
            <Border StrokeShape="RoundRectangle 16" Padding="0" HorizontalOptions="Center"
                    HeightRequest="300" WidthRequest="220" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1"/>
                </Border.Shadow>
                <Image Source="{Binding Card.ImageUri}"
                       Aspect="AspectFit"
                       HeightRequest="300"
                       WidthRequest="220" />
            </Border>

            <!-- Name and Favorite -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Card.Name}"
                       FontSize="28"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                <Button Grid.Column="1"
                        Command="{Binding ToggleFavoriteCommand}"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Tertiary}"
                        HeightRequest="48"
                        WidthRequest="48">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Card.IsFavorite}" Value="True">
                            <Setter Property="Text" Value="★" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Card.IsFavorite}" Value="False">
                            <Setter Property="Text" Value="☆" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Info rows -->
            <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.1"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="16">
                    <Label Grid.Row="0" Grid.Column="0" Text="Category:" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Secondary}" Padding="12,4" StrokeThickness="0" HorizontalOptions="Start">
                        <Label Text="{Binding Card.Category}" TextColor="{StaticResource OnSecondary}" FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="1" Grid.Column="0" Text="Rarity:" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Tertiary}" Padding="12,4" StrokeThickness="0" HorizontalOptions="Start">
                        <Label Text="{Binding Card.Rarity}" TextColor="{StaticResource OnTertiary}" FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="2" Grid.Column="0" Text="Condition:" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Card.Condition}" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Est. Value:" FontAttributes="Bold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource OnSurface}, Dark={StaticResource OnSurfaceDark}}" />
                    <Label Grid.Row="3" Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalTextAlignment="Center">
                        <Label.Text>
                            <Binding Path="Card.EstimatedValue" StringFormat="$ {0:N2}" />
                        </Label.Text>
                    </Label>
                </Grid>
            </Border>

            <!-- Description -->
            <Label Text="{Binding Card.Description}"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OnSurfaceVariantDark}}"
                   LineBreakMode="WordWrap" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Text="Edit"
                        Command="{Binding GoToEditCardCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontAttributes="Bold" />
                <Button Grid.Column="1"
                        Text="Delete"
                        Command="{Binding DeleteCardCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="{StaticResource OnError}"
                        CornerRadius="8"
                        HeightRequest="48"
                        FontAttributes="Bold" />
            </Grid>

            <!-- Back button -->
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    HeightRequest="48"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
