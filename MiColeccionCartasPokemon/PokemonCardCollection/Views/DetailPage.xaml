<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokemonCardCollection.ViewModels"
             x:Class="PokemonCardCollection.Views.DetailPage"
             x:DataType="vm:DetailViewModel"
             Title="Card Details"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource OffBlack}}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Card image -->
            <Border StrokeShape="RoundRectangle 16" Padding="0" HorizontalOptions="Center"
                    HeightRequest="260" WidthRequest="260">
                <Image Source="{Binding Card.ImageUri}"
                       Aspect="AspectFill"
                       HeightRequest="260"
                       WidthRequest="260" />
            </Border>

            <!-- Name and Favorite -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Card.Name}"
                       FontSize="28"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center" />
                <Button Grid.Column="1"
                        Text="{Binding Card.IsFavorite, Converter={x:Null}}" 
                        Command="{Binding ToggleFavoriteCommand}"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Tertiary}">
                    <!-- Placeholder: show ★ or ☆ depending on IsFavorite -->
                </Button>
            </Grid>

            <!-- Info rows -->
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Black}}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="16">
                    <Label Grid.Row="0" Grid.Column="0" Text="Category:" FontAttributes="Bold" />
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Secondary}" Padding="8,4" StrokeThickness="0" HorizontalOptions="Start">
                        <Label Text="{Binding Card.Category}" TextColor="{StaticResource White}" FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="1" Grid.Column="0" Text="Rarity:" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Tertiary}" Padding="8,4" StrokeThickness="0" HorizontalOptions="Start">
                        <Label Text="{Binding Card.Rarity}" TextColor="{StaticResource Black}" FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="2" Grid.Column="0" Text="Condition:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Card.Condition}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Est. Value:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" TextColor="{StaticResource Primary}" FontAttributes="Bold">
                        <Label.Text>
                            <Binding Path="Card.EstimatedValue" StringFormat="$ {0:N2}" />
                        </Label.Text>
                    </Label>
                </Grid>
            </Border>

            <!-- Description -->
            <Label Text="{Binding Card.Description}"
                   FontSize="15"
                   TextColor="{StaticResource Outline}"
                   LineBreakMode="WordWrap" />

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Text="Edit"
                        Command="{Binding GoToEditCardCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="8"
                        FontAttributes="Bold" />
                <Button Grid.Column="1"
                        Text="Delete"
                        Command="{Binding DeleteCardCommand}"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="{StaticResource White}"
                        CornerRadius="8"
                        FontAttributes="Bold" />
            </Grid>

            <!-- Back button -->
            <Button Text="← Back"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
