<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokemonCardCollection.ViewModels"
             x:Class="PokemonCardCollection.Views.ListPage"
             x:DataType="vm:ListViewModel"
             Title="My Collection"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Header with Add button -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Spacing="8" Margin="0,0,0,16">
            <Button Text="＋ Add Card"
                    Command="{Binding GoToAddCardCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="16,8" />
        </HorizontalStackLayout>

        <!-- Card list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Cards}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding GoToDetailCommand}"
                        SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
                        
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No cards yet!" FontSize="20" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                    <Label Text="Tap + Add Card to start your collection." FontSize="14" TextColor="{StaticResource Outline}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource Black}}" Padding="12">
                        <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                            <!-- Card thumbnail -->
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUri}"
                                   Aspect="AspectFill"
                                   HeightRequest="80"
                                   WidthRequest="80" />

                            <!-- Card info -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Secondary}" Padding="8,4" StrokeThickness="0">
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="{StaticResource White}" FontAttributes="Bold" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Tertiary}" Padding="8,4" StrokeThickness="0">
                                        <Label Text="{Binding Rarity}" FontSize="12" TextColor="{StaticResource Black}" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label FontSize="14" TextColor="{StaticResource Primary}" FontAttributes="Bold">
                                    <Label.Text>
                                        <Binding Path="EstimatedValue" StringFormat="$ {0:N2}" />
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
