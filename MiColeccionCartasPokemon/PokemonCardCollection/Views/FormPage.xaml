<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PokemonCardCollection.ViewModels"
             xmlns:dtos="clr-namespace:PokemonCardCollection.Data.DTOs"
             x:Class="PokemonCardCollection.Views.FormPage"
             x:DataType="vm:FormViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}">

    <Grid>
        <!-- SEARCH VIEW -->
        <Grid IsVisible="{Binding IsSearchVisible}" RowDefinitions="Auto, *">
            <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="12,8">
                <!-- Search Input -->
                <SearchBar Text="{Binding SearchQuery}" 
                           SearchCommand="{Binding SearchApiCommand}" 
                           Placeholder="Search by name (optional)..." />

                <!-- Filters Section -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Type Filter -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Pokemon type" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
                        <Border StrokeShape="RoundRectangle 8" 
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" 
                                Stroke="{StaticResource Outline}" 
                                StrokeThickness="1" 
                                Padding="8,0">
                            <Picker Title="Select Type..."
                                    ItemsSource="{Binding AvailableTypes}" 
                                    SelectedItem="{Binding SelectedType}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Rarity Filter -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Pokemon rarity" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
                        <Border StrokeShape="RoundRectangle 8" 
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" 
                                Stroke="{StaticResource Outline}" 
                                StrokeThickness="1" 
                                Padding="8,0">
                            <Picker Title="Select Rarity..."
                                    ItemsSource="{Binding AvailableRarities}" 
                                    SelectedItem="{Binding SelectedRarity}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Search and Clear Buttons -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,4">
                    <Button Grid.Column="0"
                            Text="🔍 Search" 
                            Command="{Binding SearchApiCommand}" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="{StaticResource OnPrimary}" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="44" />
                    <Button Grid.Column="1"
                            Text="Clear"
                            Command="{Binding ResetFiltersCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Outline}"
                            BorderWidth="1"
                            TextColor="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            CornerRadius="8"
                            HeightRequest="44"
                            Padding="16,0" />
                </Grid>
            </VerticalStackLayout>

            <!-- Initial state / Instructions -->
            <VerticalStackLayout Grid.Row="1" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center" 
                                 Spacing="12"
                                 IsVisible="{Binding ShowInitialState}"
                                 Padding="32">
                <Label Text="🔎" FontSize="48" HorizontalOptions="Center" />
                <Label Text="Search pokemon cards" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource Outline}" />
                <Label Text="Enter a name or select a type and/or rarity above, then press 'Search' to query the database." HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{StaticResource Outline}" />
            </VerticalStackLayout>

            <!-- No results message -->
            <VerticalStackLayout Grid.Row="1" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center" 
                                 Spacing="12"
                                 IsVisible="{Binding ShowNoResults}"
                                 Padding="32">
                <Label Text="❌" FontSize="48" HorizontalOptions="Center" />
                <Label Text="No results found" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource Outline}" />
                <Label Text="No pokemon cards were found with the selected filters. Try modifying the type, rarity, or name." HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{StaticResource Outline}" />
            </VerticalStackLayout>

            <ActivityIndicator Grid.Row="1" 
                               IsRunning="{Binding IsSearching}" 
                               IsVisible="{Binding IsSearching}" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               Color="{StaticResource Primary}" />

            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding SearchResults}" 
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:TcgCardDto">
                        <Border Margin="8" Padding="8" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Stroke="{StaticResource Outline}" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FormViewModel}}, Path=SelectApiCardCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="60,*">
                                <!-- Note: Since the API returns the base URL, we append /low.webp to display the thumbnail -->
                                <Image Source="{Binding Image, StringFormat='{0}/low.webp'}" WidthRequest="60" HeightRequest="80" Aspect="AspectFit" />
                                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" Margin="12,0,0,0" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- FORM VIEW -->
        <ScrollView IsVisible="{Binding IsCardSelected}" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Card Preview -->
                <Image Source="{Binding ImageUri}" HeightRequest="200" Aspect="AspectFit" HorizontalOptions="Center" />

                <!-- Name (Read-Only) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Name" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Outline}">
                        <Entry Text="{Binding Name}" IsReadOnly="True" />
                    </Border>
                </VerticalStackLayout>

                <!-- Category (Read-Only) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category (Type)" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Outline}">
                        <Entry Text="{Binding Category}" IsReadOnly="True" />
                    </Border>
                </VerticalStackLayout>

                <!-- Rarity (Read-Only) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rarity" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Outline}">
                        <Entry Text="{Binding Rarity}" IsReadOnly="True" />
                    </Border>
                </VerticalStackLayout>

                <!-- Estimated Value (Read-Only) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Estimated Value ($)" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Outline}">
                        <Entry Text="{Binding EstimatedValue}" IsReadOnly="True" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description (Read-Only) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Outline}">
                        <Editor Text="{Binding Description}" IsReadOnly="True" HeightRequest="100" />
                    </Border>
                </VerticalStackLayout>

                <!-- Condition (Editable) -->
                <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                    <Label Text="Condition (Your physical card)" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" Padding="4,0" StrokeThickness="1" Stroke="{StaticResource Primary}">
                        <Picker ItemsSource="{Binding Conditions}" SelectedItem="{Binding Condition}" Title="Select condition..." />
                    </Border>
                </VerticalStackLayout>

                <!-- Is Favorite (Editable) -->
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center" Margin="0,8">
                    <Label Text="Favorite" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Switch IsToggled="{Binding IsFavorite}" />
                </HorizontalStackLayout>

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                    <Button Grid.Column="0"
                            Text="Save"
                            Command="{Binding GuardarArticuloCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource OnPrimary}"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                    <Button Grid.Column="1"
                            Text="Cancel"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource Outline}"
                            BorderWidth="1"
                            TextColor="{StaticResource Outline}"
                            CornerRadius="8"
                            HeightRequest="48"
                            FontAttributes="Bold" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
